rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn() && myProfile().status == 'active';
    }

    function isAdmin() {
      return isSignedIn() && myProfile().status == 'active' && myProfile().role == 'admin';
    }

    // Hardcoded alongside lib/firebase.ts's ADMIN_EMAILS — the only emails
    // allowed to self-activate as admin on their very first sign-in.
    function isPreApprovedAdmin(email) {
      return email in ['manik.anand@calfus.com'];
    }

    match /users/{uid} {
      // Anyone signed in can read the directory (admin tab + idea attribution).
      allow read: if isSignedIn();

      // Self sign-up: only your OWN doc, only with a verified email, and only
      // as a pending member — unless the email is pre-approved, in which case
      // it self-activates as admin. Requiring verification stops someone
      // registering a pre-approved admin's address before they do.
      // Admins can also create a doc for anyone (the "Add user" form).
      allow create: if (
          isSignedIn()
          && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && request.resource.data.email == request.auth.token.email.lower()
          && (
            (request.resource.data.status == 'pending' && request.resource.data.role == 'member')
            ||
            (isPreApprovedAdmin(request.resource.data.email)
              && request.resource.data.status == 'active'
              && request.resource.data.role == 'admin')
          )
        )
        || (
          isAdmin()
          && request.resource.data.email is string
          && request.resource.data.role in ['admin', 'member']
          && request.resource.data.status in ['active', 'pending']
        );

      // Only an active admin can approve, promote, or remove anyone
      // (including editing their own doc, e.g. to add a second admin).
      // Anyone can flip their own email-notification preference, and nothing else.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifyEmail', 'updatedAt'])
          && request.resource.data.notifyEmail is bool
        );
      allow delete: if isAdmin();
    }

    // Private per-person state (e.g. when notifications were last read).
    match /userState/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /ideas/{ideaId} {
      allow read: if isActive();

      allow create: if isActive()
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.link is string
        && request.resource.data.cost is number
        && request.resource.data.revenue is number
        && request.resource.data.cost >= 0
        && request.resource.data.revenue >= 0;

      allow delete: if isActive()
        && (resource.data.submittedByUid == request.auth.uid || isAdmin());

      // Only the points-of-contact list can change after submission, and only
      // by the submitter, an existing point of contact, or an admin.
      allow update: if isActive()
        && (
          resource.data.submittedByUid == request.auth.uid
          || isAdmin()
          || request.auth.uid in resource.data.get('contributorUids', [])
        )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['contributors', 'contributorUids', 'updatedAt'])
        && request.resource.data.contributors is list
        && request.resource.data.contributorUids is list
        && request.resource.data.contributorUids.size() <= 20;
    }
  }
}
